# ---------------------------------------------------------------------------
# DIA (Do-It Agent) environment configuration
# Copy to .env and fill in what you have. Everything has a mock fallback:
# the app runs fully in demo mode with zero external credentials.
# ---------------------------------------------------------------------------

# ----------------------------- Database ------------------------------------
# Docker compose in this repo exposes Postgres on host port 5433.
# SQLite by default (zero setup, file lives in prisma/dev.db).
# For Postgres, change provider in prisma/schema.prisma and set a postgresql:// URL.
DATABASE_URL=file:./dev.db

# ----------------------------- Backend -------------------------------------
PORT=8787
LOG_LEVEL=info
SESSION_SECRET=dev-secret-change-me
FRONTEND_ORIGIN=http://localhost:5173
# Hard limits for voice uploads
MAX_AUDIO_MB=10
MAX_AUDIO_SECONDS=30

# ----------------------------- LLM (agent brain) ---------------------------
# Provider is one of: gemini | groq | openrouter | openai | custom | mock
# Every provider uses the OpenAI chat-completions + tools wire format.
# Set provider to "mock" (or leave LLM_API_KEY empty) to run the deterministic
# demo agent that plans and composes replies from real tool results.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Gemini 3 models spend seconds "thinking" unless this is set. "none" keeps
# the spoken replies fast; use "low" or "medium" for harder questions.
# Free-tier Gemini keys allow about 20 requests per day per model, and one
# multi-tool question uses several. Use a billed key for a live demo.
LLM_REASONING_EFFORT=none
# Overrides used when LLM_PROVIDER=custom (any OpenAI-compatible endpoint)
LLM_BASE_URL=

# ----------------------------- Sarvam AI -----------------------------------
# Server-side only, never exposed to the browser.
# Leave empty to fall back to mock voice services.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TRANSLATE_MODEL=mayura:v1

# ----------------------------- n8n (optional) ------------------------------
# When unset, campaign execution and reports run through the backend's
# built-in mock workflow adapter.
N8N_WEBHOOK_BASE_URL=

# ----------------------------- Frontend (Vite) -----------------------------
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=true
